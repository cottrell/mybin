#!/bin/bash
# Simple tmux session selector

sessions=$(tmux list-sessions -F '#S' 2>/dev/null)

if [ -z "$sessions" ]; then
  echo "No tmux sessions running."
  exit 1
fi

echo "Select a tmux session:"
select session in $sessions; do
  if [ -n "$session" ]; then
    tmux attach -t "$session"
    break
  fi
done
