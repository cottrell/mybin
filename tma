#!/bin/bash

# Simple tmux session selector
sessions=$(tmux list-sessions -F '#S' 2>/dev/null)

if [ -z "$sessions" ]; then
    echo "No tmux sessions found."
    exit 1
fi

echo "Tmux Sessions:"
echo "--------------"

# This creates a numbered menu
select session in $sessions; do
    if [ -n "$session" ]; then
        tmux attach -t "$session"
        break
    fi
done
